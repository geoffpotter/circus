.DS_Store
*.log
node_modules/

# Local Claude state for the handler session, EXCEPT .claude/agents
# which is a symlink to agents/ so Claude discovers subagents per-install.
.claude/*
!.claude/agents

# Mission state lives in-tree for greppability but isn't tracked
missions/
worktrees/
inbox.json
inbox.jsonl

# Registered repos & their wikis live in-tree (each their own git repo)
repos/
wikis/
wiki/

# Old state location, in case migration leaves something behind
.circus/
